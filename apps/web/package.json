{
  "name": "@fvoci/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run i18n && vite build -c vite.pptx-frame.config.ts --logLevel warn && vite",
    "build": "pnpm run i18n && vite build -c vite.pptx-frame.config.ts && vite build",
    "check": "pnpm run i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm run i18n && vitest run",
    "build:pptx-frame": "vite build -c vite.pptx-frame.config.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent",
    "storybook": "pnpm run i18n && storybook dev --port 6006 --host 127.0.0.1 --no-open --no-version-updates",
    "build-storybook": "pnpm run i18n && storybook build --output-dir ../../target/storybook-static && cp ../../THIRD_PARTY_NOTICES.txt ../../target/storybook-static/"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@floating-ui/dom": "1.8.0",
    "@fvoci/api-client": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "diff": "9.0.0",
    "docx-preview": "0.4.1",
    "jszip": "3.10.2",
    "katex": "0.18.10",
    "read-excel-file": "9.3.12",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.1",
    "@inlang/plugin-message-format": "4.5.5",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.61.0",
    "@playwright/test": "1.64.1",
    "@storybook/svelte": "10.6.3",
    "@storybook/svelte-vite": "10.6.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "bits-ui": "2.19.5",
    "cn": "0.5.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svelte-sonner": "1.2.1",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
