  "study_action_failed": "처리하지 못했습니다.",
  "study_unit_status": "{number}. {title}: {status}",
  "study_unit_invalid": "제목과 분량(0 이상의 정수)을 확인해 주세요.",
  "study_unit_added": "단위를 더했습니다.",
  "study_heading": "계획과 내 진행",
  "study_progress": "진행률",
  "study_counts": "완료 {done} · 진행 중 {inProgress} · 남음 {remaining} / {total}",
  "study_today": "오늘",
  "study_today_counts": "예정 {planned} · 완료 {done}",
  "study_overdue_count": "밀린 단위 {count}",
  "study_amount": "분량",
  "study_none": "없음",
  "study_replan_form": "밀린 단위 다시 배정",
  "study_per_day_invalid": "하루에 할 단위 수는 1 이상의 정수입니다.",
  "study_replanned": [
    {
      "declarations": [
        "input count",
        "input start",
        "input perDay",
        "local countPlural = count: plural"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "밀린 {count}개를 {start}부터 하루 {perDay}개씩 다시 배정했습니다."
      }
    }
  ],
  "study_replan_intro": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "밀린 단위 {count}개를 내 계획으로 다시 배정:"
      }
    }
  ],
  "study_start_date": "시작일",
  "study_per_day": "하루에",
  "study_replan": "다시 배정",
  "study_planned_mine": "{date}(내 날짜)",
  "study_mine": "내 분량·날짜·메모",
