{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "study_unit_pages": "쪽",
  "study_unit_problems": "문제",
  "study_unit_minutes": "분",
  "study_unit_items": "개",
  "study_amount_pages": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": { "countPlural=other": "{count}쪽" }
    }
  ],
  "study_amount_problems": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": { "countPlural=other": "{count}문제" }
    }
  ],
  "study_amount_minutes": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": { "countPlural=other": "{count}분" }
    }
  ],
  "study_amount_items": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": { "countPlural=other": "{count}개" }
    }
  ],
  "study_amount_progress": "{done}/{amount} (남은 {left})",
  "study_status_not_started": "시작 전",
  "study_status_in_progress": "진행 중",
