{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "e2e/**/*",
    ".storybook/**/*",
    "stories/**/*",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
