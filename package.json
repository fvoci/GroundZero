{
  "name": "fvoci",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @fvoci/web run i18n && eslint .",
    "check": "pnpm --recursive --filter './apps/*' --filter './packages/*' run check",
    "test": "pnpm --recursive --filter './apps/*' --filter './packages/*' run test",
    "generate:api": "pnpm --filter @fvoci/api-client run generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
