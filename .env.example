# fvoci 서버 환경 변수 예시. 실제 비밀 값은 넣지 않는다.
# 개발·테스트는 `cargo xtask dev` / `cargo xtask test`가 Compose 포트를 찾아 자동으로 설정한다.
# 설명: docs/development.md 12절.

# --- 서버 실행 (fvoci-server) ---
# HTTP 바인드 주소 (기본 127.0.0.1:8080)
FVOCI_BIND=127.0.0.1:8080
# 브라우저가 접속하는 공개 원점. 쿠키·OIDC 리다이렉트·Origin 검사의 기준. https면 __Host- 쿠키를 쓴다.
FVOCI_PUBLIC_URL=https://fvoci.example.test
# 앱 역할(fvoci_app) 연결 문자열 (필수)
DATABASE_URL=postgres://fvoci_app:change-me@127.0.0.1:5432/fvoci
# 정적 웹 자산 디렉터리 (운영 이미지에서는 /srv/fvoci/web)
FVOCI_WEB_DIR=
# OIDC 제공자 (D-45). 발급자 URL은 디스커버리 문서의 issuer와 정확히 같아야 한다.
FVOCI_OIDC_ISSUER=https://idp.example.test/realms/example
FVOCI_OIDC_CLIENT_ID=fvoci-web
FVOCI_OIDC_CLIENT_SECRET=change-me
# 세션 절대 만료(초, 기본 43200)
FVOCI_SESSION_TTL_SECS=43200
# 실시간 공동 편집에 연결된 사람의 권한을 다시 확인하는 간격(초, 기본 30, 최소 1)
FVOCI_COLLAB_RECHECK_SECS=30
# 초기 관리자(D-51): 이 OIDC subject가 처음 로그인하면 첫 워크스페이스(이름 기본 fvoci)의 소유자가 된다. 비우면 없음
FVOCI_INITIAL_ADMIN_SUBJECT=
FVOCI_INITIAL_WORKSPACE=fvoci
# Zotero Web API 주소(D-34, 기본 https://api.zotero.org). 테스트가 대역 서버를 가리킬 때만 바꾼다
# FVOCI_ZOTERO_API_URL=https://api.zotero.org
# 운영 한도 (D-52, 기본값은 O-26에서 조정)
FVOCI_MAX_DOCUMENT_BYTES=2000000
FVOCI_MAX_TITLE_CHARS=200
FVOCI_MAX_REFERENCES_PER_DOCUMENT=500
FVOCI_MAX_DOCUMENT_DEPTH=10
# 실행 역할(O-19): all(API와 백그라운드 작업), api, worker
FVOCI_ROLE=all
# 백그라운드 작업 확인 간격(초, 5~3600)
FVOCI_WORKER_INTERVAL_SECS=60
# 통합 검색(D-39). 비우면 제목만 DB에서 찾는다. 키는 Meilisearch 마스터 키 또는 색인·문서·작업·검색 권한이 있는 API 키
FVOCI_SEARCH_URL=
FVOCI_SEARCH_KEY=
# 파일 저장소(D-06·D-61): local(기본) 또는 s3. R2는 FVOCI_S3_REGION=auto
FVOCI_STORAGE=local
FVOCI_STORAGE_DIR=data/files
FVOCI_S3_ENDPOINT=
FVOCI_S3_REGION=auto
FVOCI_S3_BUCKET=
FVOCI_S3_ACCESS_KEY=
FVOCI_S3_SECRET_KEY=
# 파일 한도(D-52, O-26 제안값)
FVOCI_MAX_FILE_BYTES=1073741824
FVOCI_UPLOAD_CHUNK_BYTES=8388608
FVOCI_MAX_WORKSPACE_STORAGE_BYTES=53687091200
FVOCI_UPLOAD_TTL_SECS=86400
FVOCI_UPLOAD_CONCURRENCY=8
# 동시에 만드는 반출 ZIP 수
FVOCI_EXPORT_CONCURRENCY=2

# --- DB 준비 (fvoci-server db bootstrap / db migrate) ---
# 역할 생성 권한이 있는 관리자 연결 (bootstrap만)
DATABASE_ADMIN_URL=postgres://postgres:change-me@127.0.0.1:5432/fvoci
# bootstrap이 만들거나 갱신할 두 역할의 비밀번호
FVOCI_DB_MIGRATOR_PASSWORD=change-me
FVOCI_DB_APP_PASSWORD=change-me
# 마이그레이션 역할(fvoci_migrator) 연결 (migrate)
DATABASE_MIGRATION_URL=postgres://fvoci_migrator:change-me@127.0.0.1:5432/fvoci

# 운영 로그(D-83): 레벨·모듈 거르기(예: info,fvoci_server::collab=debug, 없으면 RUST_LOG)와 형식.
# 개발에서는 pretty가 읽기 쉽다(같은 사건·필드를 한 줄 글로). 시작할 때 한 번 읽는다.
FVOCI_LOG=info
FVOCI_LOG_FORMAT=pretty
