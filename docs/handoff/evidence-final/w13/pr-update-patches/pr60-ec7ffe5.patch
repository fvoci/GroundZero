From ec7ffe563c47726b427b3635493c2b04ea8a09c2 Mon Sep 17 00:00:00 2001
From: FVOCI <150913557+fvoci@users.noreply.github.com>
Date: Thu, 22 Oct 2026 13:10:17 +0900
Subject: [PATCH] test(web): answer the signed-in account check in the document
 draft tests
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

For the #60 update commit (after #57 is merged). NEW in W13, not a
pre-check item: #60's 81c9d99 makes DocumentEditor ask api.me() before
every save and hold the save as 'retrying' when it cannot tell who is
signed in. #57's document-draft-offer and document-draft-conflict tests
only stub saveDocument, so the real fetch to /api/me fails in jsdom and
the saves never go out (3 vitest failures: '재시도 대기' instead of '저장됨',
no conflict panel). Stub api.me with the account the tests sign in as.
Integration rehearsal W13; not pushed to any PR branch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/web/tests/component/document-draft-conflict.test.ts | 9 +++++++++
 apps/web/tests/component/document-draft-offer.test.ts    | 9 +++++++++
 2 files changed, 18 insertions(+)

diff --git a/apps/web/tests/component/document-draft-conflict.test.ts b/apps/web/tests/component/document-draft-conflict.test.ts
index c3c9970..60692e5 100644
--- a/apps/web/tests/component/document-draft-conflict.test.ts
+++ b/apps/web/tests/component/document-draft-conflict.test.ts
@@ -52,6 +52,15 @@ beforeEach(async () => {
   Range.prototype.getClientRects = (): DOMRectList => none;
   Element.prototype.scrollIntoView = (): void => undefined;
   me.userId = 'user-a';
+  // 저장은 보내기 전에 이 창의 계정이 아직 로그인돼 있는지 묻는다.
+  vi.spyOn(api, 'me').mockResolvedValue({
+    id: 'user-a',
+    display_name: '나',
+    hour_cycle: '',
+    locale: 'ko',
+    time_zone: '',
+    week_start: '',
+  });
 });
 
 afterEach(() => {
diff --git a/apps/web/tests/component/document-draft-offer.test.ts b/apps/web/tests/component/document-draft-offer.test.ts
index 82cf207..17d7633 100644
--- a/apps/web/tests/component/document-draft-offer.test.ts
+++ b/apps/web/tests/component/document-draft-offer.test.ts
@@ -61,6 +61,15 @@ beforeEach(async () => {
   Range.prototype.getClientRects = (): DOMRectList => none;
   Element.prototype.scrollIntoView = (): void => undefined;
   me.userId = 'user-a';
+  // 저장은 보내기 전에 이 창의 계정이 아직 로그인돼 있는지 묻는다.
+  vi.spyOn(api, 'me').mockResolvedValue({
+    id: 'user-a',
+    display_name: '나',
+    hour_cycle: '',
+    locale: 'ko',
+    time_zone: '',
+    week_start: '',
+  });
   // 같은 탭에서 다시 열었다(새로고침·앱 안 이동): 지난번 편집이 이 탭의 초안으로 남아 있다.
   storeDraft('doc-1', {
     baseRevision: 5,
-- 
