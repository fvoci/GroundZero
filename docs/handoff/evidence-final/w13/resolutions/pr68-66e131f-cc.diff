 +                    r["seconds"].as_i64().unwrap(),
 +                )
 +            })
 +            .collect()
 +    };
 +
 +    // 앞쪽 00:30~00:50(CDT) 20분과, 앞쪽 00:30부터 뒤쪽 01:00(CST)까지 90분.
 +    add("2025-11-02T04:30:00Z", "2025-11-02T04:50:00Z").await;
 +    add("2025-11-02T04:30:00Z", "2025-11-02T06:00:00Z").await;
 +    let day = get(
