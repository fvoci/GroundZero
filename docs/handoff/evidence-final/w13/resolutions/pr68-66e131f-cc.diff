 +/// 전에는 잠그기 전에 고른 목록을 잠근 뒤에도 그대로 써서, 방금 독립시킨 업무가 상위 업무의 묶음으로 휴지통에 들어갔다.
 +#[tokio::test]
 +async fn trashing_a_parent_leaves_a_subtask_detached_while_it_waited() {
 +    let state = common::state();
