+            let mut txn = self.doc.transact_mut();
+            let p = fragment.push_back(&mut txn, XmlElementPrelim::empty("paragraph"));
+            p.push_back(&mut txn, XmlTextPrelim::new(text));
+        }
+        let diff = self.doc.transact().encode_state_as_update_v1(&before);
