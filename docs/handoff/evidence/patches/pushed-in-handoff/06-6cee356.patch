From 6cee356c50f9a176d71f567dd96ea75c83f35343 Mon Sep 17 00:00:00 2001
From: FVOCI <150913557+fvoci@users.noreply.github.com>
Date: Thu, 22 Oct 2026 08:18:50 +0900
Subject: [PATCH] fix(web): saving my input after a task conflict keeps the
 other person's changes to fields I did not edit
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

"내 입력으로 다시 저장" sent the whole stale form with the latest base
version, so a field the other person changed (e.g. the title) went back
to its old value without any warning. It now merges my input onto the
latest version the way refresh() does: untouched fields take the latest
values, fields I edited keep my value (the explicit "mine wins" choice),
and the latest version becomes the new baseline. Dates are compared
against the latest version, so the shift preview only appears when I
changed the dates myself.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/lib/features/tasks/TaskDetail.svelte  |  18 +-
 .../component/task-conflict-save-mine.test.ts | 262 ++++++++++++++++++
 2 files changed, 279 insertions(+), 1 deletion(-)
 create mode 100644 apps/web/tests/component/task-conflict-save-mine.test.ts

diff --git a/apps/web/src/lib/features/tasks/TaskDetail.svelte b/apps/web/src/lib/features/tasks/TaskDetail.svelte
index abaedb4..03c498b 100644
--- a/apps/web/src/lib/features/tasks/TaskDetail.svelte
+++ b/apps/web/src/lib/features/tasks/TaskDetail.svelte
@@ -191,6 +191,22 @@
     }
   }
 
+  /**
+   * 충돌 화면의 "내 입력으로 다시 저장": 서버 최신 판(`latest`) 위에 내 입력을 `refresh`와 같은 방식으로 올린 뒤 그
+   * 판 번호로 저장한다. 내가 고치지 않은 칸은 최신 값을 따르고(전에는 폼 전체를 보내 그사이 다른 사람이 바꾼 제목
+   * 등을 옛 값으로 되돌렸다), 내가 고친 칸은 서버에서도 바뀌었어도 내 값을 쓴다(사용자가 고른 것). 그래서 충돌로
+   * 남기지 않고 최신 판을 다음 비교의 기준으로 삼는다.
+   */
+  async function saveMine(latest: TaskDetailView): Promise<void> {
+    if (busy) return;
+    refresh(latest);
+    task = latest;
+    baseline = formOf(latest);
+    baseVersion = latest.version;
+    clashed = false;
+    await submit(latest);
+  }
+
   $effect(() => {
     const id = taskId;
     let cancelled = false;
@@ -587,7 +603,7 @@
               conflict = undefined;
             }}>{m.tasks_load_server()}</Button
           >
-          <Button size="sm" disabled={busy} onclick={() => void submit(latest)}
+          <Button size="sm" disabled={busy} onclick={() => void saveMine(latest)}
             >{m.tasks_save_mine()}</Button
           >
         </div>
diff --git a/apps/web/tests/component/task-conflict-save-mine.test.ts b/apps/web/tests/component/task-conflict-save-mine.test.ts
new file mode 100644
index 0000000..4a6264c
--- /dev/null
+++ b/apps/web/tests/component/task-conflict-save-mine.test.ts
@@ -0,0 +1,262 @@
+import { fireEvent, render, screen, waitFor, within } from '@testing-library/svelte';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import type { ShiftProposalView, TaskDetailView, TaskInput } from '$lib/api/client';
+import { api } from '$lib/api/client';
+import TaskDetail from '$lib/features/tasks/TaskDetail.svelte';
+import { setLocale } from '$lib/paraglide/runtime.js';
+
+// 업무 저장 충돌(409) 뒤 "내 입력으로 다시 저장"(실제 브라우저 점검에서 찾음): 전에는 내 폼 전체를 새 판 번호로 보내,
+// 내가 고치지 않은 칸(다른 사람이 바꾼 제목 등)을 옛 값으로 조용히 되돌렸다. 이제 최신 판 위에 내가 고친 칸만 올린다.
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+const v2: TaskDetailView = {
+  id: 't1',
+  item_id: 'i1',
+  module_id: 'm1',
+  workspace_id: 'ws-1',
+  parent_id: null,
+  reference: 'KED-1',
+  title: '옛 제목',
+  description: '',
+  status: 'todo',
+  priority: 'none',
+  start_date: null,
+  due_date: null,
+  estimate_minutes: null,
+  tags: [],
+  milestone: false,
+  predecessor_ids: [],
+  predecessors: [],
+  series: null,
+  occurrence_date: null,
+  assignees: [],
+  checklist_done: 0,
+  checklist_total: 0,
+  version: 2,
+  move_version: 0,
+  completed_at: null,
+  access: 'write',
+  updated_at: '2026-10-21T00:00:00Z',
+  checklist: [],
+};
+
+const unchanged: TaskInput = {
+  title: v2.title,
+  description: v2.description,
+  status: v2.status,
+  priority: v2.priority,
+  start_date: v2.start_date,
+  due_date: v2.due_date,
+  estimate_minutes: v2.estimate_minutes,
+  tags: v2.tags,
+  assignee_ids: [],
+  milestone: v2.milestone,
+};
+
+function mount(current: TaskDetailView = v2): void {
+  vi.spyOn(api, 'task').mockResolvedValue(current);
+  vi.spyOn(api, 'assignable').mockResolvedValue([]);
+  vi.spyOn(api, 'taskBacklinks').mockResolvedValue([]);
+  vi.spyOn(api, 'comments').mockResolvedValue([]);
+  render(TaskDetail, {
+    props: {
+      taskId: current.id,
+      tasks: [current],
+      workspaces: [],
+      onchanged: () => undefined,
+      onopen: () => undefined,
+    },
+  });
+}
+
+function field(id: string): HTMLInputElement | HTMLTextAreaElement {
+  const el = document.getElementById(id);
+  if (!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)) throw new Error(id);
+  return el;
+}
+
+async function type(id: string, value: string): Promise<void> {
+  await fireEvent.input(field(id), { target: { value } });
+}
+
+/** 탭 B: 판 2에서 고쳐 저장하면 충돌 화면이 뜬다. */
+async function saveIntoConflict(): Promise<void> {
+  const save = document.getElementById('task-save');
+  if (save === null) throw new Error('task-save');
+  await fireEvent.click(save);
+  await screen.findByRole('button', { name: '내 입력으로 다시 저장' });
+}
+
+describe('saving my input after a task conflict', () => {
+  it('keeps the title the other person changed when I only edited the description', async () => {
+    await setLocale('ko', { reload: false });
+    mount();
+    const v3 = { ...v2, version: 3, title: '새 제목' };
+    const v4 = { ...v3, version: 4, description: 'B 설명' };
+    const update = vi
+      .spyOn(api, 'updateTask')
+      .mockResolvedValueOnce({ kind: 'conflict', current: v3 })
+      .mockResolvedValueOnce({ kind: 'updated', task: v4 });
+    await screen.findByLabelText('설명');
+    await type('task-description', 'B 설명');
+    await saveIntoConflict();
+    expect(update).toHaveBeenNthCalledWith(1, 't1', 2, { ...unchanged, description: 'B 설명' }, []);
+
+    await fireEvent.click(screen.getByRole('button', { name: '내 입력으로 다시 저장' }));
+    await waitFor(() => {
+      expect(update).toHaveBeenCalledTimes(2);
+    });
+    expect(update).toHaveBeenNthCalledWith(
+      2,
+      't1',
+      3,
+      { ...unchanged, title: '새 제목', description: 'B 설명' },
+      [],
+    );
+    // 저장한 판으로 다시 채워 화면이 저장된 내용을 보인다.
+    expect(await screen.findByText('저장했습니다.')).toBeTruthy();
+    expect(field('task-title').value).toBe('새 제목');
+    expect(field('task-description').value).toBe('B 설명');
+    expect(screen.queryByRole('button', { name: '내 입력으로 다시 저장' })).toBeNull();
+  });
+
+  it('sends my value for a field both sides changed and the latest values for the rest', async () => {
+    await setLocale('ko', { reload: false });
+    mount();
+    const preview = vi
+      .spyOn(api, 'previewSchedule')
+      .mockResolvedValue({ shifts: [], undated: [], blocked: null });
+    const v3: TaskDetailView = {
+      ...v2,
+      version: 3,
+      title: '남의 제목',
+      priority: 'high',
+      due_date: '2026-11-05',
+      estimate_minutes: 30,
+      tags: ['서버'],
+    };
+    const v4 = { ...v3, version: 4, title: '내 제목', estimate_minutes: 45 };
+    const update = vi
+      .spyOn(api, 'updateTask')
+      .mockResolvedValueOnce({ kind: 'conflict', current: v3 })
+      .mockResolvedValueOnce({ kind: 'updated', task: v4 });
+    await screen.findByLabelText('설명');
+    await type('task-title', '내 제목');
+    await type('task-estimate', '45');
+    await saveIntoConflict();
+
+    await fireEvent.click(screen.getByRole('button', { name: '내 입력으로 다시 저장' }));
+    await waitFor(() => {
+      expect(update).toHaveBeenCalledTimes(2);
+    });
+    // 제목·예상 시간은 양쪽에서 바꿨지만 사용자가 내 입력을 골랐으므로 내 값, 고치지 않은 우선순위·마감일·태그는 최신 값.
+    expect(update).toHaveBeenNthCalledWith(
+      2,
+      't1',
+      3,
+      {
+        ...unchanged,
+        title: '내 제목',
+        priority: 'high',
+        due_date: '2026-11-05',
+        estimate_minutes: 45,
+        tags: ['서버'],
+      },
+      [],
+    );
+    // 날짜는 최신 판 그대로라 후속 업무 미리보기를 묻지 않는다(옛 날짜로 되돌리는 재배치를 제안하지 않는다).
+    expect(preview).not.toHaveBeenCalled();
+    expect(await screen.findByText('저장했습니다.')).toBeTruthy();
+    expect(field('task-title').value).toBe('내 제목');
+    expect(field('task-tags').value).toBe('서버');
+    expect(field('task-estimate').value).toBe('45');
+  });
+
+  it('previews follower moves with my new due date on top of the latest version', async () => {
+    await setLocale('ko', { reload: false });
+    const dated = { ...v2, start_date: '2026-10-19', due_date: '2026-10-21' };
+    mount(dated);
+    const shift: ShiftProposalView = {
+      task_id: 'c',
+      reference: 'KED-c',
+      title: '검토',
+      base_version: 1,
+      from_start_date: '2026-10-22',
+      from_due_date: '2026-10-23',
+      start_date: '2026-10-26',
+      due_date: '2026-10-27',
+      causes: [
+        {
+          predecessor_id: 't1',
+          predecessor_reference: 'KED-1',
+          predecessor_title: '새 제목',
+          kind: 'FS',
+          lag_days: 0,
+        },
+      ],
+    };
+    const preview = vi
+      .spyOn(api, 'previewSchedule')
+      .mockResolvedValueOnce({ shifts: [], undated: [], blocked: null })
+      .mockResolvedValueOnce({ shifts: [shift], undated: [], blocked: null });
+    const v3 = { ...dated, version: 3, title: '새 제목' };
+    const update = vi
+      .spyOn(api, 'updateTask')
+      .mockResolvedValueOnce({ kind: 'conflict', current: v3 })
+      .mockResolvedValueOnce({
+        kind: 'updated',
+        task: { ...v3, version: 4, due_date: '2026-10-25' },
+      });
+    await screen.findByLabelText('마감일');
+    await type('task-due', '2026-10-25');
+    await saveIntoConflict();
+
+    await fireEvent.click(screen.getByRole('button', { name: '내 입력으로 다시 저장' }));
+    const panel = (await screen.findByRole('heading', { name: /후속 업무 1개/ })).closest(
+      'section',
+    );
+    if (panel === null) throw new Error('panel');
+    expect(preview).toHaveBeenNthCalledWith(2, 't1', '2026-10-19', '2026-10-25');
+    // 미리보기만으로는 저장하지 않는다.
+    expect(update).toHaveBeenCalledTimes(1);
+    await fireEvent.click(within(panel).getByRole('button', { name: '후속 업무도 옮겨 저장' }));
+    await waitFor(() => {
+      expect(update).toHaveBeenCalledTimes(2);
+    });
+    expect(update).toHaveBeenNthCalledWith(
+      2,
+      't1',
+      3,
+      {
+        ...unchanged,
+        title: '새 제목',
+        start_date: '2026-10-19',
+        due_date: '2026-10-25',
+      },
+      [{ task_id: 'c', base_version: 1, start_date: '2026-10-26', due_date: '2026-10-27' }],
+    );
+  });
+
+  it('still replaces the form with the latest version when loading the server content', async () => {
+    await setLocale('ko', { reload: false });
+    mount();
+    const v3 = { ...v2, version: 3, title: '새 제목', description: 'A 설명' };
+    const update = vi
+      .spyOn(api, 'updateTask')
+      .mockResolvedValueOnce({ kind: 'conflict', current: v3 });
+    await screen.findByLabelText('설명');
+    await type('task-description', 'B 설명');
+    await saveIntoConflict();
+
+    await fireEvent.click(screen.getByRole('button', { name: '서버 내용 불러오기' }));
+    await waitFor(() => {
+      expect(screen.queryByRole('button', { name: '서버 내용 불러오기' })).toBeNull();
+    });
+    expect(field('task-title').value).toBe('새 제목');
+    expect(field('task-description').value).toBe('A 설명');
+    expect(update).toHaveBeenCalledTimes(1);
+  });
+});
