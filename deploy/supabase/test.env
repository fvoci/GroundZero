# 셀프호스트 Supabase 시험 구성의 값(`cargo xtask test --supabase`만 쓴다, D-88). 모두 이 저장소에 적힌 시험 전용
# 값이며 운영·개발에 쓰지 않는다. 공식 구성(docker/.env.example)에서 db·rest·supavisor가 읽는 것만 둔다.
POSTGRES_PASSWORD=fvoci-test-supabase-postgres-password
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=fvoci-test-supabase-jwt-secret-at-least-32-characters
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,graphql_public
SECRET_KEY_BASE=fvoci-test-supabase-secret-key-base-0123456789abcdef0123456789abcdef
VAULT_ENC_KEY=fvoci-test-supabase-vault-key-32
POOLER_TENANT_ID=fvoci-test
# 시험은 상태마다 앱 연결 풀(최대 16)을 여럿 동시에 연다. session 모드는 클라이언트마다 서버 연결을 잡고 이 수를 넘는
# 클라이언트는 거절하므로, `cargo xtask test --supabase`는 동시에 도는 시험을 64 / 16 = 4개로 묶는다(xtask/src/test.rs).
POOLER_DEFAULT_POOL_SIZE=64
POOLER_MAX_CLIENT_CONN=200
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543
