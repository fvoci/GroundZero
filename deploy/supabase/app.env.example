# 셀프호스트 Supabase의 PostgreSQL을 GroundZero DB로 쓸 때의 연결 값(docs/self-hosting-supabase.md, D-88).
# 비밀 값은 넣지 않았다: <...>를 바꿔 운영자 .env에만 둔다(저장소·로그·이미지에 넣지 않는다).
# 나머지 앱 설정(OIDC·저장소·검색 등)은 deploy/selfhost.env.example과 같다.

# 역할·스키마 준비(`fvoci-server db bootstrap`)와 복구(`backup restore`)만 쓰는 관리자 연결. Supabase의 `postgres`
# 역할(superuser 아님)이면 된다. db 서비스에 직접 연결한다(Supavisor를 거치지 않음).
DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@<db-host>:5432/postgres

# 마이그레이션(`db migrate`)·백업(`backup create`)용. 스키마 fvoci를 가진 fvoci_migrator. 직접 연결.
DATABASE_MIGRATION_URL=postgres://fvoci_migrator:<FVOCI_DB_MIGRATOR_PASSWORD>@<db-host>:5432/postgres

# 서버 런타임(앱 역할 fvoci_app, NOBYPASSRLS). 직접 연결을 권한다. Supavisor session 모드(공식 구성의 5432)도 시험했다:
#   postgres://fvoci_app.<POOLER_TENANT_ID>:<FVOCI_DB_APP_PASSWORD>@<pooler-host>:5432/postgres
# transaction 모드(6543)는 지원하지 않는다(트랜잭션 밖 세션 상태와 advisory lock을 쓴다).
DATABASE_URL=postgres://fvoci_app:<FVOCI_DB_APP_PASSWORD>@<db-host>:5432/postgres

# bootstrap이 두 역할을 만들거나 비밀번호를 맞출 때 쓴다.
FVOCI_DB_MIGRATOR_PASSWORD=<long-random>
FVOCI_DB_APP_PASSWORD=<long-random>

# 네트워크를 건너 연결하면 TLS를 켜고 인증서를 검증한다(예: URL 끝에 ?sslmode=verify-full&sslrootcert=/path/ca.crt).
# 검증을 끄는 sslmode(disable·allow·prefer·require)로 오류를 피하지 않는다. 같은 Docker 네트워크 안에서만 쓰면
# 공식 구성의 db는 TLS를 켜지 않는다.
