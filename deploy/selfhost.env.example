# 셀프호스트 .env 예시(docs/self-hosting.md). 이 파일을 .env로 복사하고 모든 change-me를 서로 다른 긴 임의 값으로 바꾼다.
# 예: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
FVOCI_DB_MIGRATOR_PASSWORD=change-me
FVOCI_DB_APP_PASSWORD=change-me
MEILI_MASTER_KEY=change-me-at-least-16-characters

# 사람들이 여는 주소(앞단 HTTPS 프록시의 주소). 쿠키·로그인 되돌아오기·Origin 검사의 기준.
FVOCI_PUBLIC_URL=https://fvoci.example.com
# 앱이 듣는 곳(기본: 이 컴퓨터에서만).
FVOCI_LISTEN=127.0.0.1:8080

# 로그인 제공자(표준 OIDC). 발급자는 디스커버리 문서의 issuer와 정확히 같아야 한다.
FVOCI_OIDC_ISSUER=https://auth.example.com/realms/fvoci
FVOCI_OIDC_CLIENT_ID=fvoci-web
FVOCI_OIDC_CLIENT_SECRET=change-me

# --profile keycloak로 같이 띄울 때만.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_LISTEN=127.0.0.1:8081
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

# 파일 저장소(기본 local). S3 호환 저장소(예: Cloudflare R2)를 쓰려면:
# FVOCI_STORAGE=s3
# FVOCI_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# FVOCI_S3_REGION=auto
# FVOCI_S3_BUCKET=fvoci
# FVOCI_S3_ACCESS_KEY=...
# FVOCI_S3_SECRET_KEY=...
