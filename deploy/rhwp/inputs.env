# HWP·HWPX 미리보기용 rhwp WASM의 빌드 입력(D-76). 이 폴더의 파일(inputs.env·Cargo.lock·deny.toml·build.sh)이
# 같으면 같은 결과를 다시 쓰고, 바뀌면 다시 빌드한다. 도구 판은 deploy/docker/app.Dockerfile의 rhwp-build 단계와
# 같아야 한다(build.sh가 확인한다).
RHWP_REPO=https://github.com/edwardkim/rhwp.git
RHWP_COMMIT=515bd72dcde0eecdeece333666b675354b7fa91d
RUST_VERSION=1.93.1
WASM_BINDGEN_VERSION=0.2.127
CARGO_DENY_VERSION=0.20.2
FEATURES=console_error_panic_hook
