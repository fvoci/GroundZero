        "type": "object",
        "description": "문서 목록 항목.",
        "required": [
          "id",
          "reference",
          "title",
          "revision",
          "updated_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DocumentId"
          },
